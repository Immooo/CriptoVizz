      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT GREATEST($__unixEpochFrom(), FLOOR(UNIX_TIMESTAMP(event_time) / (GREATEST($__interval_ms / 1000, CASE WHEN ($__unixEpochTo() - $__unixEpochFrom()) <= 86400 THEN 60 ELSE 3600 END))) * (GREATEST($__interval_ms / 1000, CASE WHEN ($__unixEpochTo() - $__unixEpochFrom()) <= 86400 THEN 60 ELSE 3600 END))) AS time, topic AS metric, SUM(article_count) AS value FROM (SELECT a.published_at AS event_time, CONVERT(t.topic USING utf8mb4) COLLATE utf8mb4_bin AS topic, 1 AS article_count, a.sentiment_score AS sentiment_sum FROM news_articles a JOIN JSON_TABLE(a.topics, '$[*]' COLUMNS(topic VARCHAR(80) PATH '$')) t WHERE $__timeFilter(a.published_at) AND ($__unixEpochTo() - $__unixEpochFrom()) <= 86400 UNION ALL SELECT bucket_start AS event_time, CONVERT(topic USING utf8mb4) COLLATE utf8mb4_bin AS topic, article_count, sentiment_sum FROM analytics_hourly WHERE bucket_start <= $__timeTo() AND bucket_start + INTERVAL 1 HOUR > $__timeFrom() AND ($__unixEpochTo() - $__unixEpochFrom()) > 86400) samples WHERE topic IN (${topic:sqlstring}) GROUP BY 1, 2 ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "News volume by topic",
      "type": "timeseries",
      "description": "Up to 24 hours: exact publication-time filter with adaptive intervals (minimum 1 minute). Longer ranges use retained hourly aggregates; boundary hours may be partial. Articles may belong to several topics.",
      "interval": "1m"
